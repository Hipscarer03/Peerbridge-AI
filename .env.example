# PeerBridge (P-005) — biến môi trường
# ============================================
# KHÔNG commit file .env thật. Ứng dụng có 3 nơi đọc biến:
#
# 1. Backend PeerBridge (backend/app): copy backend/.env.example -> backend/.env.
#    Danh sách đầy đủ (JWT_SECRET, OPENAI_API_KEY, LLM_*, PLAN_*, VISION_*, LITESTREAM_*...) nằm trong file đó.
#
# 2. Frontend (frontend/): tạo frontend/.env.local với biến dưới đây.
#    NEXT_PUBLIC_* được đưa vào bundle lúc build => đổi giá trị phải build lại.
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# 3. Thư mục gốc (file .env này): template BTC trong src/ (Dockerfile, docker-compose, Makefile ở gốc)
#    và hook ghi log AI. Không phải ứng dụng PeerBridge.

# ---- Template src/ (src/config.py) ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

# ---- Hook ghi log AI (BTC cung cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
