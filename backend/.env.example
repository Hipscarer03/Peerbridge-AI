# Backend local: cd backend; python run.py. Chỉ backend/.env được đọc ở cwd này.
# Biến môi trường tiến trình ưu tiên hơn .env; restart sau khi sửa.
# Docker ở gốc chạy src.main:app (template khác), không phải backend/app.

# === Application ===
# development bật reload; local chỉ bind loopback.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Đường dẫn avatar tương đối tính từ backend/; giới hạn upload MB và quota REST/phút.
UPLOAD_DIRECTORY=./data/uploads
<<<<<<< HEAD
# Ảnh chat riêng tư, không mount public qua /uploads.
CHAT_UPLOAD_DIRECTORY=./data/chat_images
=======
>>>>>>> 29066618049be865e9daa585fed068c149bc780f
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=120

# === Database ===
# SQLite runtime: đường dẫn tương đối tính từ backend/.
DATABASE_PATH=./data/dongdieu.db
# Để trống: SQLAlchemy/Alembic dùng cùng SQLite. URL riêng không chuyển repositories sqlite3 sang PostgreSQL.
DATABASE_URL=

# === Authentication ===
# BẮT BUỘC: tự tạo chuỗi ngẫu nhiên mạnh, điền trong file thật; không dùng literal placeholder.
# Giữ nguyên secret đang dùng để không vô hiệu token hiện tại.
JWT_SECRET=
# Thời hạn access token, phút.
ACCESS_TOKEN_MINUTES=1440

# === CORS ===
# Origin frontend chính xác, phân cách dấu phẩy, không có dấu / cuối.
# Chỉ thêm null khi chủ đích cho phép frontend file://.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# === OpenAI / LLM ===
# Moderator hỗ trợ fake/openai; openai gọi chat/completions.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Điền key trong file thật; legacy dùng OPENAI_API_KEY trực tiếp.
OPENAI_API_KEY=
# Tùy chọn key riêng Moderator: nếu không trống, ưu tiên hơn OPENAI_API_KEY.
LLM_API_KEY=
# Model của legacy /api/v1/agent/chat, KHÔNG điều khiển Moderator.
OPENAI_MODEL=gpt-4o-mini
<<<<<<< HEAD
