>>>>>>> 29066618049be865e9daa585fed068c149bc780f
# Timeout từng call (giây) và JSON mode.
LLM_TIMEOUT_SECONDS=20
LLM_JSON_MODE=true
# Judge bổ sung tốn thêm call; tắt trong kiểm tra ban đầu.
OUTPUT_GUARD_LLM_JUDGE=false
# Budget 1–3 calls/tin, timeout tổng (giây) và quota WS user/phút.
MAX_LLM_CALLS=3
MODERATION_TIMEOUT_SECONDS=30
MODERATION_MESSAGES_PER_MINUTE=30
# Ngưỡng risk 0..1 để escalation theo action policy.
RISK_ESCALATE_THRESHOLD=0.8

# === Embedding ===
# SentenceTransformer local, không có OpenAI embedding API/provider env.
# Phải đúng model đã tạo index; cùng chiều vector chưa chứng minh tương thích.
# Runtime dùng query:/passage: và normalized vectors. Index hiện có CHƯA được xác nhận.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# === Qdrant / RAG ===
# qdrant dùng E5 thật; fake dùng offline. Chỉ dùng sau xác nhận index/corpus.
RETRIEVER_PROVIDER=qdrant
# TODO: xác nhận URL server đang chạy và collection/alias hiện có.
# Code chưa đọc QDRANT_API_KEY; không hỗ trợ Qdrant Cloud cần key qua .env.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=course_materials
# Số chunks và ngưỡng cosine; 0.78 chưa được hiệu chuẩn trên corpus thật.
RAG_TOP_K=4
RAG_MIN_SCORE=0.78
# Corpus/course/ACL nằm trong index/DB, không có CORPUS_PATH hoặc COURSE_ID env.
# Không ingest để thử cấu hình; truy xuất/warmup không tạo collection hoặc payload index.

# === Logging và Monitoring ===
# backend/app không đọc LOG_LEVEL/SENTRY_DSN/OTEL_* qua Settings.
# Mức logging Uvicorn truyền bằng CLI nếu cần, không thêm env giả.
